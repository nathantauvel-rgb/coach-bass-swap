// Règles de sécurité de la base DJingood, à coller dans la console Firebase
// (Firestore Database → Règles → Publier).
//
// La plus importante : chaque joueur connecté ne peut lire et écrire QUE son propre document.
// Personne ne peut lire la progression d'un autre, et personne ne peut rien écrire sans être connecté.
// Seule exception (lot 46) : la collection `avis`, où n'importe qui peut DÉPOSER un avis, connecté ou non,
// sans jamais pouvoir le relire, le modifier ou l'effacer. Seule l'équipe les lit, dans la console Firebase.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /joueurs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;   // « write » comprend créer, modifier et supprimer
      // Pas de limite de taille ici : les règles Firestore ne savent pas mesurer un document en octets
      // (`request.resource.size()` n'existe pas, c'est une notion de Firebase Storage). Firestore refuse
      // de lui-même au-delà de 1 Mo, et le site s'arrête avant (CPT_MAX dans js/compte.js).
    }

    // Un champ de texte facultatif, pas plus long que `max`
    function texte(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    // Un avis tel que le site l'envoie (avisDoc dans js/avis.js), et rien d'autre
    function avisOk(d) {
      return d.keys().hasOnly(['v', 'quand', 'jour', 'ecran', 'note', 'bloque', 'plu', 'parcours', 'table', 'appareil', 'uid'])
        && d.v == 1 && d.quand == request.time
        && d.note is int && d.note >= 0 && d.note <= 5
        && texte(d, 'jour', 10) && texte(d, 'ecran', 80) && texte(d, 'bloque', 1000) && texte(d, 'plu', 1000)
        && texte(d, 'parcours', 20) && texte(d, 'table', 120) && texte(d, 'appareil', 80)
        && (!('uid' in d) || (request.auth != null && d.uid == request.auth.uid));
    }
    match /avis/{id} {
      allow create: if avisOk(request.resource.data);
    }

    // Tout le reste est fermé
    match /{document=**} { allow read, write: if false; }
  }
}
